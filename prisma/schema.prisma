generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id        Int    @id @default(autoincrement())
  nome      String
  email     String @unique
  senhaHash String
  tipo      Role

  // Ministérios que o usuário lidera
  ministeriosLiderados Ministerio[] @relation("LiderMinisterio")

  // Ministérios que o usuário participa como voluntário
  ministerios UsuarioMinisterio[]

  escalas Escala[]
}

model Ministerio {
  id        Int     @id @default(autoincrement())
  nome      String
  descricao String?
  liderId   Int
  Usuario? @relation(fields: [liderId], references: [id])

  // Voluntários nesse ministério
  usuarios UsuarioMinisterio[]

  escalas Escala[]
}

model UsuarioMinisterio {
  id           Int @id @default(autoincrement())
  usuarioId    Int
  ministerioId Int

  usuario    Usuario    @relation(fields: [usuarioId], references: [id])
  ministerio Ministerio @relation(fields: [ministerioId], references: [id])

  @@unique([usuarioId, ministerioId]) // Evita duplicação
}

model Escala {
  id           Int        @id @default(autoincrement())
  dataHora     DateTime
  ministerioId Int
  ministerio   Ministerio @relation(fields: [ministerioId], references: [id])
  voluntarios  Usuario[]
}

enum Role {
  admin
  lider
  voluntario
}
