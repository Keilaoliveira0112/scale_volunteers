generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Usuario {
  id           Int                 @id @default(autoincrement())
  nome         String
  email        String              @unique
  senhaHash    String
  tipo         Role
  criadoEm     DateTime            @default(now())
  atualizadoEm DateTime            @updatedAt @default(now())

  // Relações
  ministeriosLiderados Ministerio[]     @relation("LiderMinisterio")
  ministerios          UsuarioMinisterio[]
  escalas              EscalaVoluntario[]
}

model Ministerio {
  id          Int           @id @default(autoincrement())
  nome        String
  descricao   String?
  liderId     Int
  lider       Usuario        @relation("LiderMinisterio", fields: [liderId], references: [id])
  usuarios    UsuarioMinisterio[]
  escalas     Escala[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([liderId])
}

enum MembershipStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

model UsuarioMinisterio {
  id           Int @id @default(autoincrement())
  usuarioId    Int
  ministerioId Int
  status       MembershipStatus @default(PENDENTE)
  criadoEm     DateTime @default(now())

  usuario    Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  ministerio Ministerio @relation(fields: [ministerioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, ministerioId])
  @@index([usuarioId])
  @@index([ministerioId])
}

model Escala {
  id           Int        @id @default(autoincrement())
  dataHora     DateTime
  ministerioId Int
  ministerio   Ministerio @relation(fields: [ministerioId], references: [id], onDelete: Cascade)
  voluntarios  EscalaVoluntario[]  @relation("EscalaVoluntarios")

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([ministerioId])
}

model EscalaVoluntario {
  id                 Int      @id @default(autoincrement())
  escalaId           Int
  voluntarioId       Int
  presenteConfirmado Boolean @default(false)
  criadoEm           DateTime @default(now())

  escala     Escala  @relation("EscalaVoluntarios", fields: [escalaId], references: [id], onDelete: Cascade)
  voluntario Usuario @relation("UsuarioEscalas", fields: [voluntarioId], references: [id], onDelete: Cascade)

  @@unique([escalaId, voluntarioId])
  @@index([escalaId])
  @@index([voluntarioId])
}

enum Role {
  admin
  lider
  voluntario
}
